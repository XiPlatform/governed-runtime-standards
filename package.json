{
  "name": "governed-runtime",
  "version": "1.0.0",
  "description": "Reference implementation of the Governed Runtime Standards: the Action Provenance Record, the Action Approval Attestation, and the Governed Runtime Profile. Verifiable records of what an AI agent did, and on whose authority.",
  "license": "Apache-2.0",
  "author": "Renly (XiPlatform Pty Ltd)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/action-provenance": "./schema/action-provenance-1.0.schema.json",
    "./schema/action-approval": "./schema/action-approval-1.0.schema.json"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "specs",
    "test-vectors",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test-vectors": "tsc -p tsconfig.json && node scripts/generate-test-vectors.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ai",
    "agents",
    "provenance",
    "audit",
    "governance",
    "accountability",
    "ai-provenance",
    "action-provenance",
    "governed-runtime",
    "approval",
    "human-in-the-loop"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/XiPlatform/governed-runtime-standards"
  },
  "bugs": {
    "url": "https://github.com/XiPlatform/governed-runtime-standards/issues"
  },
  "homepage": "https://renly.ai/standards",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.4",
    "vitest": "^3.0.0"
  }
}
